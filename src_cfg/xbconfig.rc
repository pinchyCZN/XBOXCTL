/*
 * xbconfig.rc - the dialogs.
 *
 * THE PAD CONTROL BUTTONS ARE NOT HERE. They are created at runtime
 * from a table keyed by the CORE_SA_* constants, so a button cannot
 * exist on the dialog without a source in core.h to drive it, and
 * adding a control to the pad is one table entry rather than an edit in
 * two files that can drift apart.
 */

#include <windows.h>
#include "resource.h"

IDD_MAIN DIALOGEX 0, 0, 483, 262
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION |
      WS_SYSMENU
CAPTION "XBOXCTL Configurator"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Profile", IDC_PROFILEGROUP, 7, 7, 40, 8
    LISTBOX         IDC_PROFILES, 7, 18, 124, 186,
                    LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Add Config...", IDC_ADD, 7, 208, 60, 14
    PUSHBUTTON      "A&pply to Pad", IDC_APPLY, 71, 208, 60, 14

    LTEXT           "&Layer", IDC_LAYERLABEL, 7, 229, 24, 8
    COMBOBOX        IDC_LAYER, 32, 226, 99, 60,
                    CBS_DROPDOWNLIST | WS_TABSTOP

    GROUPBOX        "Controls", IDC_PADGROUP, 138, 3, 338, 201

    LTEXT           "", IDC_STATUS, 138, 230, 338, 18
    DEFPUSHBUTTON   "Close", IDCANCEL, 426, 208, 50, 14
END

IDD_BIND DIALOGEX 0, 0, 266, 214
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION |
      WS_SYSMENU
CAPTION "Binding"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CONTROL, 7, 7, 252, 8
    LTEXT           "&Action", -1, 7, 22, 40, 8
    LISTBOX         IDC_ACTION, 7, 33, 110, 106,
                    LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP

    LTEXT           "&Value", IDC_CODELABEL, 125, 22, 60, 8
    EDITTEXT        IDC_CODE, 125, 33, 80, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "&Capture...", IDC_CAPTURE, 209, 33, 50, 13

    CONTROL         "&Repeat (autofire)", IDC_REPEAT, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 125, 54, 100, 10
    CONTROL         "&Toggle (latch)", IDC_TOGGLE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 125, 67, 100, 10
    CONTROL         "A&nalog (pass pressure)", IDC_ANALOG, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 125, 80, 100, 10
    CONTROL         "Pass&through (keep pad button)", IDC_PASSTHROUGH,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    125, 93, 130, 10

    LTEXT           "Rate (Hz)", IDC_HZLABEL, 125, 110, 40, 8
    EDITTEXT        IDC_HZ, 168, 108, 37, 13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Delay (ms)", IDC_DELAYLABEL, 125, 127, 40, 8
    EDITTEXT        IDC_DELAY, 168, 125, 37, 13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Hard (%)", IDC_HARDLABEL, 125, 144, 40, 8
    EDITTEXT        IDC_HARD, 168, 142, 37, 13, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "", IDC_PREVIEW, 7, 163, 252, 18

    PUSHBUTTON      "C&lear Binding", IDC_CLEAR, 7, 193, 60, 14
    DEFPUSHBUTTON   "OK", IDOK, 155, 193, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 209, 193, 50, 14
END

IDD_CAPTURE DIALOGEX 0, 0, 180, 70
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "Capture"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Press a key. Escape cancels.", -1, 7, 7, 166, 16
    LTEXT           "", IDC_CAPTURED, 7, 28, 166, 12
    PUSHBUTTON      "Cancel", IDCANCEL, 65, 48, 50, 14
END

IDD_NEWNAME DIALOGEX 0, 0, 200, 76
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION |
      WS_SYSMENU
CAPTION "New Configuration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Name for the new configuration:", -1, 7, 7, 186, 8
    EDITTEXT        IDC_NEWNAME, 7, 20, 186, 13, ES_AUTOHSCROLL
    LTEXT           "It becomes <name>.txt in the profiles folder.",
                    -1, 7, 38, 186, 8
    DEFPUSHBUTTON   "OK", IDOK, 89, 55, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 143, 55, 50, 14
END

IDD_STICK DIALOGEX 0, 0, 270, 273
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION |
      WS_SYSMENU
CAPTION "Stick"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_ST_WHICH, 7, 7, 238, 8
    LTEXT           "&Mode", -1, 7, 23, 50, 8
    COMBOBOX        IDC_ST_MODE, 60, 20, 90, 60,
                    CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT           "&Deadzone", -1, 7, 41, 50, 8
    EDITTEXT        IDC_ST_DEADZONE, 60, 39, 50, 13,
                    ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "of 35000", -1, 114, 41, 40, 8

    LTEXT           "&Outer", -1, 7, 58, 50, 8
    EDITTEXT        IDC_ST_OUTER, 60, 56, 50, 13,
                    ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "treated as full", -1, 114, 58, 60, 8

    LTEXT           "&Speed", -1, 7, 75, 50, 8
    EDITTEXT        IDC_ST_MAXSPEED, 60, 73, 50, 13,
                    ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "", IDC_ST_SPEEDUNIT, 114, 75, 130, 8

    LTEXT           "&Curve", -1, 7, 93, 50, 8
    COMBOBOX        IDC_ST_CURVE, 60, 90, 90, 60,
                    CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT           "&Gain X", -1, 7, 111, 50, 8
    EDITTEXT        IDC_ST_GAINX, 60, 109, 50, 13,
                    ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "128 = 1.0", -1, 114, 111, 50, 8

    LTEXT           "Gain &Y", -1, 7, 128, 50, 8
    EDITTEXT        IDC_ST_GAINY, 60, 126, 50, 13,
                    ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "128 = 1.0", -1, 114, 128, 50, 8

    CONTROL         "&Invert X", IDC_ST_INVX, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 60, 144, 50, 10
    CONTROL         "In&vert Y", IDC_ST_INVY, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 114, 144, 50, 10

    LTEXT           "Smoot&h", -1, 7, 160, 50, 8
    EDITTEXT        IDC_ST_SMOOTH, 60, 158, 50, 13,
                    ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "ms, rise only", -1, 114, 160, 60, 8

    GROUPBOX        "Turn acceleration", -1, 7, 176, 238, 40
    LTEXT           "Rate", -1, 14, 190, 24, 8
    EDITTEXT        IDC_ST_ARATE, 40, 188, 36, 13,
                    ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Max", -1, 82, 190, 20, 8
    EDITTEXT        IDC_ST_AMAX, 104, 188, 36, 13,
                    ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Decay", -1, 146, 190, 26, 8
    EDITTEXT        IDC_ST_ADECAY, 174, 188, 36, 13,
                    ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Threshold", -1, 14, 205, 36, 8
    EDITTEXT        IDC_ST_ATHRESH, 52, 203, 36, 13,
                    ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Rate 0 switches it off", -1, 94, 205, 116, 8

    /*
     * THREE LINES, NOT ONE. The hint runs to 88 characters and about
     * 59 fit across 238 dialog units at 8pt, so a single-line field
     * clips the rest in silence - LTEXT wraps, but only into the
     * height it is given.
     */
    /*
     * THE CURVE, DRAWN. Top level with the curve box, bottom level
     * with the smooth box, which is what makes it read as belonging
     * to the numbers on its left. SS_OWNERDRAW rather than a class of
     * its own: the parent gets WM_DRAWITEM and there is nothing to
     * register.
     */
    CONTROL         "", IDC_ST_GRAPH, "Static",
                    SS_OWNERDRAW | WS_VISIBLE, 170, 90, 100, 81

    LTEXT           "", IDC_ST_HINT, 7, 220, 238, 26

    PUSHBUTTON      "De&fault", IDC_ST_DEFAULT, 7, 252, 50, 14
    PUSHBUTTON      "Off", IDC_ST_OFF, 61, 252, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 159, 252, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 213, 252, 50, 14
END

IDD_LAYER DIALOGEX 0, 0, 252, 158
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION |
      WS_SYSMENU
CAPTION "Layer"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_LY_WHICH, 7, 7, 238, 18

    LTEXT           "&Button", -1, 7, 32, 44, 8
    COMBOBOX        IDC_LY_BTN1, 54, 29, 110, 120,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "&And", -1, 7, 50, 44, 8
    COMBOBOX        IDC_LY_BTN2, 54, 47, 110, 120,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "optional", -1, 168, 50, 40, 8

    LTEXT           "", IDC_LY_HINT, 7, 70, 238, 34

    LTEXT           "", IDC_LY_PREVIEW, 7, 110, 238, 18

    PUSHBUTTON      "C&lear", IDC_LY_CLEAR, 7, 137, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 141, 137, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 195, 137, 50, 14
END

IDD_CHORD DIALOGEX 0, 0, 266, 209
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION |
      WS_SYSMENU
CAPTION "Chord"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CH_WHICH, 7, 7, 252, 8
    COMBOBOX        IDC_CH_M1, 7, 19, 80, 160,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_CH_M2, 90, 19, 80, 160,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_CH_M3, 173, 19, 80, 160,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "&Action", -1, 7, 42, 40, 8
    LISTBOX         IDC_CH_ACTION, 7, 53, 110, 100,
                    LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP

    LTEXT           "&Value", -1, 125, 42, 60, 8
    EDITTEXT        IDC_CH_CODE, 125, 53, 80, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "&Capture...", IDC_CH_CAPTURE, 209, 53, 50, 13

    CONTROL         "&Toggle (latch)", IDC_CH_TOGGLE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 125, 74, 120, 10
    CONTROL         "&Repeat (autofire)", IDC_CH_REPEAT, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 125, 87, 120, 10

    LTEXT           "Rate (Hz)", -1, 125, 104, 40, 8
    EDITTEXT        IDC_CH_HZ, 168, 102, 37, 13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Delay (ms)", -1, 125, 121, 40, 8
    EDITTEXT        IDC_CH_DELAY, 168, 119, 37, 13,
                    ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "", IDC_CH_PREVIEW, 7, 158, 252, 18

    PUSHBUTTON      "C&lear Chord", IDC_CH_CLEAR, 7, 188, 60, 14
    DEFPUSHBUTTON   "OK", IDOK, 155, 188, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 209, 188, 50, 14
END
